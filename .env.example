VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend de autenticación y datos
AUTH_SERVER_PORT=9000
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=qa_session
SESSION_TTL_DAYS=30

# Firebase Admin: usa una de estas opciones o GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Seed del primer administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Administrador
ADMIN_ROLE=admin
